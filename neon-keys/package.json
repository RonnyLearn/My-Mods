{
  "name": "neon-keys",
  "private": true,
  "version": "0.1.0",
  "description": "Neon web piano & visualizer: play with a MIDI keyboard or QWERTY, falling notes, practice modes, MIDI recording.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "desktop": "npm run build && electron .",
    "desktop:dev": "electron . --dev",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never"
  },
  "devDependencies": {
    "@audio-samples/piano-mp3-velocity12": "^1.0.5",
    "@audio-samples/piano-mp3-velocity5": "^1.0.5",
    "@types/node": "^26.6.3",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "main": "electron/main.mjs",
  "author": "RonnyLearn",
  "build": {
    "appId": "com.ronnylearn.neonkeys",
    "productName": "NeonKeys",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "NeonKeys-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "NeonKeys-${version}-portable.${ext}"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.music"
    },
    "linux": {
      "target": "AppImage",
      "category": "Audio"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/RonnyLearn/My-Mods.git",
    "directory": "neon-keys"
  }
}
